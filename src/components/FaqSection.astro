---
import type { SiteFaqItem, FaqTopic } from '../data/faq';
import SectionHeader from './SectionHeader.astro';
import Icon from './icons/Icon.astro';
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from '@/components/starwind/accordion';

interface Props {
  items: SiteFaqItem[];
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  titleId?: string;
  headingAs?: 'h1' | 'h2';
  showFilters?: boolean;
  filterTopics?: FaqTopic[];
  centered?: boolean;
  /** FAQ column alignment (product pages use left) */
  contentAlign?: 'left' | 'center';
  id?: string;
  class?: string;
}

const {
  items,
  eyebrow = 'FAQ',
  title = 'Straight answers before checkout.',
  subtitle = 'Compatibility, bans and access—no vague promises.',
  titleId = 'faq-heading',
  headingAs = 'h2',
  showFilters = false,
  filterTopics,
  centered = false,
  contentAlign = 'center',
  id: sectionId,
  class: className,
} = Astro.props;

const topicLabels: Record<FaqTopic, string> = {
  all: 'All',
  plans: 'Plans',
  esp: 'ESP',
  aim: 'Aim',
  safety: 'Safety',
  blog: 'Blog',
  setup: 'Setup',
};

const filters = filterTopics ?? (['all', 'plans', 'esp', 'aim', 'safety', 'setup'] as FaqTopic[]);
---

<section
  id={sectionId}
  class:list={['py-16 md:py-24', className]}
  aria-labelledby={titleId}
  data-faq-section={showFilters ? '' : undefined}
>
  <div class="mx-auto max-w-6xl px-5">
    <div class:list={[contentAlign === 'center' && 'mx-auto max-w-3xl', contentAlign === 'left' && 'product-detail__narrow max-w-3xl']}>
    <SectionHeader
      as={headingAs}
      eyebrow={eyebrow}
      title={title}
      desc={subtitle}
      titleId={titleId}
      centered={centered}
    />

    {
      showFilters && (
        <div
          class:list={[
            'mt-8 flex flex-col gap-3',
            contentAlign === 'center' ? 'items-center' : 'items-start',
          ]}
          data-faq-filters
        >
          <label class="faq-search flex w-full max-w-md items-center gap-2 rounded-full border border-border bg-background px-3 py-2 text-sm text-muted-foreground focus-within:border-primary">
            <Icon name="search" size={16} />
            <input
              type="search"
              placeholder="Search questions"
              aria-label="Search questions"
              data-faq-search
              class="w-full min-w-0 border-0 bg-transparent text-foreground outline-none placeholder:text-muted-foreground"
            />
          </label>
          <div
            class:list={[
              'flex flex-wrap gap-2',
              contentAlign === 'center' ? 'justify-center' : 'justify-start',
            ]}
          >
            {filters.map((topic, i) => (
              <button
                type="button"
                class:list={[
                  'faq-filter-chip rounded-full border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors hover:border-primary hover:text-foreground',
                  { 'is-active': i === 0 },
                ]}
                data-faq-filter={topic}
              >
                {topicLabels[topic]}
              </button>
            ))}
          </div>
        </div>
      )
    }

    <Accordion type="single" collapsible class="mt-8 w-full" data-faq-list>
      {items.map((faq, i) => (
        <div data-faq-topic={faq.topic}>
          <AccordionItem value={`faq-${i}`}>
            <AccordionTrigger class="text-left">
              <span class="flex items-center gap-2">
                <Icon name={faq.icon} size={16} class="shrink-0" />
                <span>{faq.q}</span>
              </span>
            </AccordionTrigger>
            <AccordionContent>
              <div class="prose prose-sm dark:prose-invert max-w-none text-muted-foreground" set:html={faq.aHtml ?? faq.a} />
            </AccordionContent>
          </AccordionItem>
        </div>
      ))}
    </Accordion>
    </div>
  </div>
</section>
