---
import type { ProductPage } from '../../data/products';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../icons/Icon.astro';
import { Button } from '@/components/starwind/button';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
---

<section
  class="border-b border-border bg-muted/10 py-12 md:py-16"
  aria-labelledby="product-highlights-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Summary"
      title="Core capabilities at a glance"
      desc={`Short list before the experience walkthrough and guides for ${product.name}.`}
      titleId="product-highlights-title"
    />

    <ul class="mt-8 grid gap-0 border border-border sm:grid-cols-2">
      {
        product.features.map((feature, index) => (
          <li
            class:list={[
              'flex items-start gap-3 border-b border-border px-4 py-3 text-sm',
              index % 2 === 0 ? 'sm:border-r' : '',
            ]}
          >
            <Icon name="check" size={15} class="mt-0.5 shrink-0 text-primary" />
            <span class="text-muted-foreground">{feature}</span>
          </li>
        ))
      }
    </ul>

    {
      product.more > 0 && (
        <p class="mt-4 text-sm text-muted-foreground">
          Plus {product.more} additional modules in the manifest above.
        </p>
      )
    }

    <div class="mt-8 flex flex-wrap gap-3">
      <Button type="button" data-scroll-target="product-experience" variant="outline" size="sm" class="rounded-md">
        Experience section
        <Icon name="chevronDown" size={16} />
      </Button>
      <Button as="a" href={product.buyUrl} variant="primary" size="sm" class="rounded-md">
        Checkout
        <Icon name="arrowRight" size={16} />
      </Button>
    </div>
  </div>
</section>
