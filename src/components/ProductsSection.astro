---
import '../styles/product-cheat-page.css';
import '../styles/store-catalog.css';
import { t } from '../i18n';
import { productPages } from '../data/products';
import SectionHeader from './SectionHeader.astro';
import StoreCatalogBlock from './store/StoreCatalogBlock.astro';

const s = t.products;
const product = productPages[0]!;
---

<section
  id="products"
  class="relative overflow-hidden border-y border-border bg-background py-20 md:py-28"
  aria-labelledby="products-title"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_80%_55%_at_50%_-5%,var(--primary)_0%,transparent_58%)] opacity-[0.12]"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto max-w-6xl px-5">
    <SectionHeader as="h2" eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />
    <StoreCatalogBlock product={product} variant="teaser" />
  </div>
</section>
