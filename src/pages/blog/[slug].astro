---
import BlogArticlePage from '../../components/BlogArticlePage.astro';
import { getAllBlogSlugs } from '../../data/blog';

export function getStaticPaths() {
  return getAllBlogSlugs().map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug!;
---

<BlogArticlePage slug={slug} canonicalPath={`/${slug}/`} />
