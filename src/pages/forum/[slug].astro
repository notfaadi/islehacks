---
import ForumDiscussionPage from '../../components/ForumDiscussionPage.astro';
import { forumPosts } from '../../data/forum';

export function getStaticPaths() {
  return forumPosts.map((post) => ({ params: { slug: post.slug } }));
}

const slug = Astro.params.slug!;
---

<ForumDiscussionPage slug={slug} canonicalPath={`/${slug}/`} />
